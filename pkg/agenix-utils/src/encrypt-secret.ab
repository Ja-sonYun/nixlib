import { file_exists } from "std/fs"
import { env_var_get } from "std/env"

main(args) {
    let key = env_var_get("AGE_RECIPIENTS_FILE") failed {
        echo "AGE_RECIPIENTS_FILE not set"
        fail 1
    }
    if key == "" {
        echo "AGE_RECIPIENTS_FILE not set"
        fail 1
    }

    if len(args) < 2 {
        echo "Usage: encrypt-secret <file.env>"
        fail 1
    }

    let file = args[1]

    if not file_exists(file) {
        echo "File not found: {file}"
        fail 1
    }

    let output = "{file}.age"
    let encrypted = $ mktemp -- "{output}.XXXXXX" $?
    trust $
        encrypt_secret_tmp="{encrypted}"
        trap 'rm -f -- "\$encrypt_secret_tmp"' EXIT
        trap 'exit 129' HUP
        trap 'exit 130' INT
        trap 'exit 131' QUIT
        trap 'exit 141' PIPE
        trap 'exit 143' TERM
    $

    $ age --encrypt -R "{key}" -o "{encrypted}" "{file}" $ failed {
        echo "Failed to encrypt {file}"
        fail 1
    }

    if file_exists(output) {
        $ chmod --reference="{output}" -- "{encrypted}" $?
    }
    $ mv -fT -- "{encrypted}" "{output}" $ failed {
        echo "Failed to replace {output}"
        fail 1
    }

    $ rm -- "{file}" $ failed {
        echo "Failed to remove {file}"
        fail 1
    }

    echo "Encrypted: {file} -> {output}"
}
