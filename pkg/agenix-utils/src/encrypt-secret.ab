import { file_exists } from "std/fs"
import { env_var_get } from "std/env"

main(args) {
    let key = env_var_get("AGE_RECIPIENTS_FILE") failed {
        echo "AGE_RECIPIENTS_FILE not set"
        fail 1
    }
    if key == "" {
        echo "AGE_RECIPIENTS_FILE not set"
        fail 1
    }

    if len(args) < 2 {
        echo "Usage: encrypt-secret <file.env>"
        fail 1
    }

    let file = args[1]

    if not file_exists(file) {
        echo "File not found: {file}"
        fail 1
    }

    let output = "{file}.age"
    let directory = $ dirname -- "{file}" $?
    let source_id = $ stat --format='%d:%i' -- "{file}" $?
    let temporary = "{directory}/.tmp"
    $ mkdir -p -m 700 -- "{temporary}" $?
    let work = $ mktemp -d -- "{temporary}/encrypt.XXXXXXXXXX" $?
    let captured = "{work}/plaintext"
    let encrypted = "{work}/ciphertext"
    trust $
        umask 077
        encrypt_secret_source="{file}"
        encrypt_secret_work="{work}"
        encrypt_secret_output="{output}"
        encrypt_secret_matches_source() (
            entry="\$1"
            [ "\$(stat --format='%d:%i' -- "\$entry")" = "{source_id}" ] || exit 1
            if [ -L "\$entry" ]; then
                entry=\$(readlink -- "\$entry") || exit 1
                case "\$entry" in
                    /*) ;;
                    *) entry="{directory}/\$entry" ;;
                esac
            fi
            sha256sum --check --status "{work}/digest" < "\$entry"
        )
        encrypt_secret_output_state() (
            if [ -e "\$encrypt_secret_output" ] || [ -L "\$encrypt_secret_output" ]; then
                stat --format='%d:%i' -- "\$encrypt_secret_output" && sha256sum < "\$encrypt_secret_output"
            else
                echo absent
            fi
        )
        trap '
            encrypt_secret_status=\$?
            trap "" HUP INT QUIT PIPE TERM
            saved="\$encrypt_secret_work/plaintext"
            rm -f -- "\$encrypt_secret_work/ciphertext" "\$encrypt_secret_work/digest"
            if [ -e "\$saved" ] || [ -L "\$saved" ]; then
                if ln -PT -- "\$saved" "\$encrypt_secret_source"; then
                    rm -- "\$saved"
                else
                    echo "Original preserved at: \$saved" >&2
                    exit 1
                fi
            fi
            rmdir -- "\$encrypt_secret_work"
            exit "\$encrypt_secret_status"
        ' EXIT
        trap 'exit 129' HUP
        trap 'exit 130' INT
        trap 'exit 131' QUIT
        trap 'exit 141' PIPE
        trap 'exit 143' TERM
    $

    let original = $ encrypt_secret_output_state $?
    $ (
        set -o pipefail
        exec 7> >(sha256sum > "{work}/digest") || exit 1
        hash_pid=\$!
        status=0
        tee /dev/fd/7 < "{file}" | age --encrypt -R "{key}" -o "{encrypted}" || status=\$?
        exec 7>&-
        wait "\$hash_pid" || exit 1
        exit "\$status"
    ) $ failed {
        echo "Failed to encrypt {file}"
        fail 1
    }

    $ exec 8< "{directory}" $?
    $ flock -x 8 $?
    $ encrypt_secret_matches_source "{file}" $ failed {
        echo "Source changed during encryption: {file}"
        fail 1
    }
    $ mv --no-copy -T -- "{file}" "{captured}" $?
    $ encrypt_secret_matches_source "{captured}" $ failed {
        echo "Source changed before removal: {file}"
        fail 1
    }
    let current = $ encrypt_secret_output_state $?
    if current != original {
        echo "Secret changed during encryption: {output}"
        fail 1
    }

    if file_exists(output) {
        $ chmod --reference="{output}" -- "{encrypted}" $?
    }
    $ mv --no-copy -fT -- "{encrypted}" "{output}" $ failed {
        echo "Failed to replace {output}"
        fail 1
    }

    $ rm -- "{captured}" $?

    echo "Encrypted: {file} -> {output}"
}
