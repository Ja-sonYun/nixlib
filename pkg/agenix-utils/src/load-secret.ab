import { file_exists } from "std/fs"
import { env_var_get } from "std/env"
import { join, split_lines, starts_with, trim } from "std/text"

main(args) {
    let key = env_var_get("AGE_IDENTITY_FILE") failed {
        echo "AGE_IDENTITY_FILE not set"
        fail 1
    }
    if key == "" {
        echo "AGE_IDENTITY_FILE not set"
        fail 1
    }

    if len(args) < 2 {
        echo "Usage: load-secret <file.age>"
        fail 1
    }

    let file = args[1]

    if not file_exists(file) {
        echo "Secret not found: {file}"
        fail 1
    }

    let content = $ age --decrypt -i "{key}" "{file}" $?

    let unquoted = "([^[:space:]\"'\\\\;&|<>()`]|\\\\.)"
    let single_quoted = "'[^']*'"
    let double_quoted = "\"([^\"\\\\]|\\\\.)*\""
    let assignment = "^[A-Za-z_][A-Za-z0-9_]*=({unquoted}|{single_quoted}|{double_quoted})*([[:space:]]+#.*)?$"
    let exports = [Text]

    for raw_line in split_lines(content) {
        let line = trim(raw_line)
        if line == "" or starts_with(line, "#") {
            continue
        }

        $
            [[ "{line}" =~ {assignment} ]] &&
                printf '%s\n' "export {line}" | bash -n 2>/dev/null
        $ failed {
            trust $ echo "Invalid single-line assignment in {file}" >&2 $
            fail 1
        }
        exports += ["export {line}"]
    }

    if len(exports) > 0 {
        echo join(exports, "\n")
    }
}
