import { file_exists } from "std/fs"
import { env_var_get } from "std/env"

main(args) {
    let key = env_var_get("AGE_IDENTITY_FILE") failed {
        echo "AGE_IDENTITY_FILE not set"
        fail 1
    }
    if key == "" {
        echo "AGE_IDENTITY_FILE not set"
        fail 1
    }
    let pubkey = env_var_get("AGE_RECIPIENTS_FILE") failed {
        echo "AGE_RECIPIENTS_FILE not set"
        fail 1
    }
    if pubkey == "" {
        echo "AGE_RECIPIENTS_FILE not set"
        fail 1
    }
    let editor = env_var_get("EDITOR")?
    if editor == "" {
        editor = "vi"
    }

    if len(args) < 2 {
        echo "Usage: edit-secret <file.age>"
        fail 1
    }

    let file = args[1]

    if not file_exists(file) {
        echo "File not found: {file}"
        fail 1
    }

    let tmp = $ mktemp $?
    trust $
        edit_secret_tmp="{tmp}"
        edit_secret_output=""
        edit_secret_keep_tmp=0
        trap '
            edit_secret_status=\$?
            if [ -n "\$edit_secret_output" ]; then
                rm -f -- "\$edit_secret_output"
            fi
            if [ "\$edit_secret_keep_tmp" = 1 ]; then
                echo "Edited secret preserved at: \$edit_secret_tmp" >&2
            else
                rm -f -- "\$edit_secret_tmp"
            fi
            exit "\$edit_secret_status"
        ' EXIT
        trap 'exit 129' HUP
        trap 'exit 130' INT
        trap 'exit 131' QUIT
        trap 'exit 141' PIPE
        trap 'exit 143' TERM
    $

    $ age --decrypt -i "{key}" -o "{tmp}" "{file}" $ failed {
        echo "Failed to decrypt {file}"
        fail 1
    }

    trust $ edit_secret_keep_tmp=1 $

    $ "{editor}" "{tmp}" $ failed {
        echo "Editor exited with error"
        fail 1
    }

    let encrypted = $ mktemp -- "{file}.XXXXXX" $?
    trust $ edit_secret_output="{encrypted}" $

    $ age --encrypt -R "{pubkey}" -o "{encrypted}" "{tmp}" $ failed {
        echo "Failed to re-encrypt {file}"
        fail 1
    }

    $ chmod --reference="{file}" -- "{encrypted}" $?
    $ mv -f -- "{encrypted}" "{file}" $ failed {
        echo "Failed to replace {file}"
        fail 1
    }

    trust $ edit_secret_keep_tmp=0 $

    echo "Updated: {file}"
}
